# =============================================================================
#  .env.example  →  PLANTILLA de variables de entorno
# =============================================================================
#  ¿CÓMO FUNCIONA?
#  1. Copia este fichero y renómbralo a ".env"  (cp .env.example .env)
#  2. Rellena ".env" con TUS valores reales.
#  3. ".env" está en .gitignore => Git NUNCA lo subirá al repositorio,
#     de modo que tus secretos no se filtran.
#
#  Este ".env.example" SÍ se sube: sirve para que otra persona sepa qué
#  variables necesita crear y con qué formato, sin descubrir los valores reales.
#
#  Docker Compose lee automáticamente el fichero ".env" del directorio
#  donde ejecutas `docker compose up`.
# =============================================================================

# --- PostgreSQL ---
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio_user
POSTGRES_PASSWORD=cambia_esta_password_en_local

# --- Backend (Spring Boot) ---
# URL de conexión JDBC. Ojo: el host es "postgres" (el nombre del servicio
# en docker-compose), NO "localhost", cuando backend corre dentro de Docker.
# Puerto 5432 = puerto INTERNO del contenedor (el host usa 5433, ver compose).
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/portfolio
SPRING_DATASOURCE_USERNAME=portfolio_user
SPRING_DATASOURCE_PASSWORD=portfolio_password

# --- Seguridad JWT ---
# Secreto usado para firmar los tokens. Debe ser largo (>= 32 bytes).
# Genera uno tuyo con:  openssl rand -base64 48
JWT_SECRET=pon_aqui_un_secreto_largo_y_aleatorio_de_al_menos_32_bytes
