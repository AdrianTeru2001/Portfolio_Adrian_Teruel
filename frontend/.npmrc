# Configuración npm del proyecto (frontend/)
#
# legacy-peer-deps=true
# ─────────────────────
# Por qué está aquí: npm 10 (el que trae Node 22) tiene un bug conocido en
# la resolución de *peer dependencies* que revienta con
#   "TypeError: Cannot read properties of null (reading 'edgesOut')"
# al instalar vitest. Con esta opción npm se salta la resolución de peers
# (que ya cuadran: @angular/build pide vitest ^4 y tenemos vitest 4) y la
# instalación funciona igual en Windows que dentro del contenedor de Docker,
# donde `npm ci` debe reproducir EXACTAMENTE este package-lock.json.
#
# Si algún día actualizas npm (`npm i -g npm@latest`), prueba a borrar esta
# línea: con npm 11 el bug ya no existe y la validación estricta de peers
# vuelve a ser una red de seguridad más.
legacy-peer-deps=true
