# =============================================================================
#  .gitignore
# =============================================================================
#  Ficheros que Git debe IGNORAR (no trackear ni subir al repositorio).
#  Se organiza por bloques: primero lo general, luego por tecnología.
#  Documentación oficial: https://git-scm.com/docs/gitignore
# =============================================================================

# -----------------------------------
# BLOQUE 1: Sistema operativo
# -----------------------------------
# Ficheros que Windows/macOS generan sola y no aportan nada al proyecto.
# "Thumbs.db" = miniaturas de Windows; ".DS_Store" = Finder de macOS.
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# -----------------------------------
# BLOQUE 2: Editores / IDEs
# -----------------------------------
# Cada desarrollador tiene su propia configuración local de IDE;
# subirla causaría conflictos constantes entre máquinas.
.idea/            # IntelliJ IDEA / WebStorm
.vscode/          # VS Code (configuración compartida se haría con .vscode/extensions.json a parte)
*.iml             # ficheros de módulo de IntelliJ
*.ipr
*.iws
.project          # Eclipse
.classpath
.settings/
*.swp             # vim

# -----------------------------------
# BLOQUE 3: Variables de entorno (¡CRÍTICO!)
# -----------------------------------
# Archivos .env contienen contraseñas, secretos JWT, credenciales de BBDD...
# Subirlos a un repositorio público = filtración de secretos.
# SIEMPRE se ignora el .env, y se sube un ".env.example" (sin valores reales)
# que sirve de plantilla para quien cloné el proyecto.
.env
.env.*
!.env.example

# -----------------------------------
# BLOQUE 4: Java / Spring Boot (backend)
# -----------------------------------
# Ficheros compilados y dependencias locales:
target/                    # directorio de salida de Maven/Gradle
build/                     # idem para Gradle
*.class                    # bytecode compilado
*.jar
*.war
*.ear
out/                       # salida de IntelliJ para módulos Java

# Logs: nunca se versionan (suelen ocupar mucho y cambian constantemente).
*.log
logs/

# Si usas Spring Boot con actuator y métricas locales:
.spring/

# Ficheros de IDE de Eclipse/IntelliJ ya cubiertos arriba.

# -----------------------------------
# BLOQUE 5: Node.js / Angular (frontend)
# -----------------------------------
# node_modules: contiene TODAS las dependencias instaladas.
# Se regenera con `npm install` a partir de package.json, por eso NO se sube.
# (El repo sería enorme e innecesariamente lento).
node_modules/

# Angular: carpeta de build resultante de `ng build`.
# Es código GENERADO: se reconstruye en cada deploy / CI.
dist/
.angular/

# Cachés de npm.
.npm/

# -----------------------------------
# BLOQUE 6: Builds y cobertura
# -----------------------------------
coverage/            # informes de cobertura de tests (jest/istanbul)
*.lcov
.nyc_output/

# -----------------------------------
# BLOQUE 7: Varios
# -----------------------------------
*.tmp
*.bak
.cache/
